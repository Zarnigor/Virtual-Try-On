# Model for the JSON checks (prompts 01-03). The only place the model name is set; nothing is hard-coded.
GEMINI_VALIDATION_MODEL=
GEMINI_API_KEY=your-gemini-api-key-here
SECRET_KEY=change-this-in-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
SIGNED_URL_SECRET=change-this-too
# Daily AI checks per user (Asia/Tashkent day). AI_UNAVAILABLE never counts. Production default for both: 5.
AI_DAILY_LIMIT=5
# Dev value: higher so garment testing is not blocked (production default is 5).
AI_GARMENT_DAILY_LIMIT=30
# Local dev only (ignored unless DEBUG=1): 1 skips the AI checks and marks garments "DEV: tekshirilmagan". Keep 0.
AI_DEV_BYPASS=0
# AI garment cleaning (prompt 04, removes hangers). Needs prepaid image-model credits; prompt 04 is not built yet,
# so 1 makes garment jobs fail with CLEAN_FAILED. Keep 0: garments are cleaned by rembg only.
AI_CLEANING_ENABLED=0
# Body AI check (prompt 02) on own-body uploads. 0 = skip it (local DEBUG only; production always checks).
BODY_AI_CHECK_ENABLED=1
# Demo mode: serve precomputed try-on results (manage.py build_demo --garments /demo_garments). Keep 0 otherwise.
DEMO_MODE=0
# Try-on realism effects (shading from the avatar, contact shadow, 1 px edge feather). Off = plain opaque garment.
TRYON_SHADING=0
TRYON_CONTACT_SHADOW=0
TRYON_EDGE_FEATHER=0
# Structural try-on steps (docs/06 "Layer order"). Set one to 0 if it produces artifacts on your garments.
TRYON_SHOULDER_CAP=1
TRYON_HEM_SNAP=1
TRYON_HALO_REMOVAL=1
TRYON_NECK_FIX=1  # neck zone: transparent inner back collar, smooth feathered head/neck edge, smooth shoulder edge
TRYON_DROPPED_SHOULDER_SINGLE=0  # 1 = dropped-shoulder T-shirts as one piece; off: sleeves shear below the armpit (docs/09 #90)
TRYON_NECK_GAP_FILL=1  # skin colour over the avatar's tank collar left between the neck and the T-shirt collar
# Near-solid garments: remove 80 % of the photo's low-frequency lighting when cleaned (prints are left alone).
GARMENT_FLATTEN_LIGHTING=1
