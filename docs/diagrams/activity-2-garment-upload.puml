@startuml
!include _style.puml
title Activity 2: Kiyim yuklash, tozalash va public qilish

|Foydalanuvchi|
start
repeat
  :Rasm yuklash,\ntur tanlash (futbolka / shim);
  |Tizim|
  :Kod tekshiruvi\n(hajm, oʻlcham, tur);
  if (Kod OK?) then (ha)
    |AI|
    #E6DDF8:Kirish tekshiruvi\n(bitta kiyim, old tomon);
    |Tizim|
    if (AI OK?) then (ha)
      :Fonni olib tashlash (rembg)\n(AI tozalash hozircha oʻchiq);
      :Sifat tekshiruvi\n(rang, shakl oʻzgarmaganmi);
      if (Sifat OK?) then (ha)
        |Foydalanuvchi|
        :Natijani koʻrish;
        if (Saqlaysizmi?) then (ha)
          :1-qadam: asosiy nuqtalarni belgilash\n(yoqasiz), fit_mode va jins tanlash;
          if (Futbolkami?) then (ha)
            if (2-qadam: yoqa?) then (belgilash)
              :Yoqaning 3 nuqtasi +\n«Yoqa teshigi» polygoni\n(tavsiya qilingan shakl, tahrirlash);
            else (oʻtkazib yuborish)
              :Yoqa belgilanmagan\n(«Boʻyin belgilanmagan»);
            endif
          else (shim)
          endif
          |Tizim|
          :Kiyimni saqlash\n(egasiga darhol koʻrinadi);
          if (Hamma uchunmi?) then (ha)
            |AI|
            #E6DDF8:AI moderatsiya;
            |Tizim|
            if (Qaror?) then (approve)
              :Umumiy katalogga qoʻshish;
            elseif (Qaror?) then (review)
              :Admin navbatiga qoʻyish;
            else (reject)
              :Yashirish;
            endif
          else (yoʻq)
          endif
          stop
        else (yoʻq)
          |Foydalanuvchi|
          :Bekor qilindi;
          stop
        endif
      else (yoʻq)
        |Foydalanuvchi|
        :Sababni koʻrish;
      endif
    else (yoʻq)
      |Foydalanuvchi|
      :Sababni koʻrish;
    endif
  else (yoʻq)
    |Foydalanuvchi|
    :Sababni koʻrish;
  endif
repeat while (qayta yuklash?) is (ha)
@enduml
